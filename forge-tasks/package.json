{
  "name": "forge-tasks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Forge Tasks — таск-трекер для Windows с облачной синхронизацией и напоминаниями в Telegram",
  "author": "Forge",
  "main": "desktop/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node tests/parser.test.mjs && node tests/db.test.mjs && node tests/sync.test.mjs && node tests/reminders.test.mjs",
    "dist:win": "electron-builder --win nsis --x64",
    "dist:portable": "electron-builder --win portable --x64",
    "release:win": "electron-builder --win nsis --x64 --publish always"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.forge.forgetasks",
    "productName": "Forge Tasks",
    "asar": true,
    "compression": "normal",
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "files": [
      "desktop/**/*",
      "supabase/functions/_shared/**/*",
      "task-manager.html",
      "assets/icon.ico",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "AbobaCDA",
        "repo": "LLTasker",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "artifactName": "Forge-Tasks-Setup-${version}.${ext}",
      "include": "assets/installer.nsh",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "language": "1049",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Forge Tasks",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "Forge-Tasks-Portable-${version}.${ext}",
      "requestExecutionLevel": "user"
    }
  }
}
